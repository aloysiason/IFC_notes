@article{ ISI:000179334900004,
Author = {Gunnarson, BE and Linderholm, HW},
Title = {Low-frequency summer temperature variation in central Sweden since the
   tenth century inferred from tree rings},
Journal = {HOLOCENE},
Year = {2002},
Volume = {12},
Number = {6},
Pages = {667-671},
Abstract = {Living and subfossil Scots pine (Pinus sylvestris L.) sampled close to
   the present tree-line in the central Scandinavian Mountains were used to
   build a continuous 1091-year long tree-ring-width chronology, spanning
   from AD 909 to 1998. Summer temperatures of the growth year had the
   highest influence on annual growth. The Hackren chronology represent a
   record of summer temperatures, where periods of low growth and poor
   regeneration of pine represent unfavourable climate conditions. Low
   growth was encountered in the mid-twelfth, thirteenth, late sixteenth,
   early seventeenth and late eighteenth centuries. Periods of high growth
   (high regeneration rate and above-average growth), indicating high
   summer temperatures, were recognized in the mid-tenth to late eleventh,
   mid-fourteenth, mid-seventeenth and twentieth centuries. As the
   chronology is well correlated with other high-latitude proxy data from
   Fennoscandia, as well as the Northern Hemisphere, we argue that the
   Hackren chronology is a valid proxy-data record of regional summer
   temperatures.},
