@article{ ISI:000237375500010,
Author = {Mann, ME},
Title = {Climate changes over the past millennium: Relationships with
   Mediterranean climates},
Journal = {NUOVO CIMENTO DELLA SOCIETA ITALIANA DI FISICA C-COLLOQUIA ON PHYSICS},
Year = {2006},
Volume = {29},
Number = {1},
Pages = {73-80},
Month = {JAN-FEB},
Note = {Workshop on Historical Reconstruction of Climate Variability and Change
   in Mediterranean Regions, Bologna, ITALY, OCT 05-06, 2004},
Abstract = {Evidence is reviewed for climate change and its causes over the interval
   spanning roughly the past millennium. Particular emphasis is placed oil
   patterns of climate change influencing Mediterranean climates of the
   Northern Hemisphere. The evidence is taken from studies using
   high-resolution climate ``proxy{''} data sources, and climate modeling
   simulations. The available evidence suggests that forced changes in
   dynamical modes of variability including the North Atlantic Oscillation
   (NAO) and El Nino/Southern Oscillation (ENSO) have played a key role in
   the patterns of climate variability in Mediterranean regions over the
   past millennium.},
