@article{ ISI:000178759300002,
Author = {Mokhov, II and Demchenko, PF and Eliseev, AV and Khon, VC and
   Khvorost'yanov, DV},
Title = {Estimation of global and regional climate changes during the 19th-21st
   centuries on the basis of the IAP RAS model with consideration for
   anthropogenic forcing},
Journal = {IZVESTIYA ATMOSPHERIC AND OCEANIC PHYSICS},
Year = {2002},
Volume = {38},
Number = {5},
Pages = {555-568},
Month = {SEP-OCT},
Abstract = {Possible global and regional climate changes during the 21st century are
   analyzed on the basis of the calculations with the IAP RAS climate model
   (CM) of intermediate complexity under different scenarios of
   anthropogenic forcings. Under one of the scenarios, the CO2 content in
   the atmosphere was specified for the 1860-1990 period according to
   observational data and for the 1991-2100 period according to the IS92a
   scenario. Under the other scenario, the CO2 content was also specified
   according to the observational data for the 1860-1990 period and did not
   vary after 1990. Possible variations in global surface air temperature
   and precipitation and also in the characteristics of atmospheric
   circulation, in particular, the North Atlantic and Arctic oscillations,
   were estimated. Estimates were also obtained for the regional changes in
   the hydrological regime, including the precipitation and runoff in the
   basins of the Volga and Caspian Sea and major Siberian rivers, such as
   Ob, Yenisei, and Lena, and for the boundaries of the areas whose
   conditions favor the formation of both continuous and discontinuous
   permafrost, for example in Eurasia. Comparison of climate changes
   obtained with the IAP RAS CM under different scenarios allows one to
   estimate the possible global and regional changes due to anthropogenic
   forcings after 1990.},
