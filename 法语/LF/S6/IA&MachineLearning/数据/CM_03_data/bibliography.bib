@article{ ISI:000237449600002,
Author = {Lund, DC and Curry, W},
Title = {Florida Current surface temperature and salinity variability during the
   last millennium},
Journal = {PALEOCEANOGRAPHY},
Year = {2006},
Volume = {21},
Number = {2},
Month = {MAY 5},
Abstract = {The salinity and temperature of the Florida Current are key parameters
   affecting the transport of heat into the North Atlantic, yet little is
   known about their variability on centennial timescales. Here we report
   replicated, high-resolution foraminiferal records of Florida Current
   surface hydrography for the last millennium from two coring sites, Dry
   Tortugas and the Great Bahama Bank. The oxygen isotopic composition of
   Florida Current surface water (delta O-18(w)) near Dry Tortugas
   increased 0.4 parts per thousand during the course of the Little Ice Age
   (LIA) (similar to 1200-1850 A. D.), equivalent to a salinity increase of
   0.8-1.5. On the Great Bahama Bank, where surface waters are influenced
   by the North Atlantic subtropical gyre, delta O-18(w) increased by 0.3
   parts per thousand during the last 200 years. Although a portion
   (similar to 0.1 parts per thousand) of this shift may be an artifact of
   anthropogenically driven changes in surface water Sigma CO2, the
   remaining delta O-18(w) signal implies a 0.4-1 increase in salinity
   after 200 years B.P. The simplest explanation of the delta O-18(w) data
   is southward migration of the Atlantic Hadley circulation during the
   LIA. Scaling of the delta O-18(w) records to salinity using the modern
   low-latitude delta O-18(w)-S slope produces an unrealistic reversal in
   the salinity gradient between the two sites. Only if delta O-18(w) is
   scaled to salinity using a high-latitude delta O-18(w)-S slope can the
   records be reconciled. Variable atmospheric C-14 paralleled Dry Tortugas
   delta O-18(w), suggesting that solar irradiance paced centennial-scale
   migration of the Inter-Tropical Convergence Zone and changes in Florida
   Current salinity during the last millennium.},
