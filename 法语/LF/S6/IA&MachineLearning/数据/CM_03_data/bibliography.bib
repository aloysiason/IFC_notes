@article{ ISI:000322886400005,
Author = {Blanco-Pastor, J. L. and Fernandez-Mazuecos, M. and Vargas, P.},
Title = {Past and future demographic dynamics of alpine species: limited genetic
   consequences despite dramatic range contraction in a plant from the
   Spanish Sierra Nevada},
Journal = {MOLECULAR ECOLOGY},
Year = {2013},
Volume = {22},
Number = {16},
Pages = {4177-4195},
Month = {AUG},
Abstract = {Anthropogenic global climate change is expected to cause severe range
   contractions among alpine plants. Alpine areas in the Mediterranean
   region are of special concern because of the high abundance of endemic
   species with narrow ranges. This study combined species distribution
   models, population structure analyses and Bayesian skyline plots to
   trace the past and future distribution and diversity of Linaria
   glacialis, an endangered narrow endemic species that inhabits summits of
   Sierra Nevada (Spain). The results showed that: (i) the habitat of this
   alpine-Mediterranean species in Sierra Nevada suffered little changes
   during glacial and interglacial stages of late Quaternary; (ii) climatic
   oscillations in the last millennium (Medieval Warm Period and Little Ice
   Age) moderately affected the demographic trends of L. glacialis; (iii)
   future warming conditions will cause severe range contractions; and (iv)
   genetic diversity will not diminish at the same pace as the distribution
   range. As a consequence of the low population structure of this species,
   genetic impoverishment in the alpine zones of Sierra Nevada should be
   limited during range contraction. We conclude that maintenance of large
   effective population sizes via high mutation rates and high levels of
   gene flow may promote the resilience of alpine plant species when
   confronted with global warming.},
Publisher = {WILEY-BLACKWELL},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
Type = {Article},
Language = {English},
Affiliation = {Blanco-Pastor, JL (Reprint Author), CSIC, RJB, Plaza Murillo 2, E-28014 Madrid, Spain.
   Blanco-Pastor, J. L.; Fernandez-Mazuecos, M.; Vargas, P., CSIC, RJB, E-28014 Madrid, Spain.},
DOI = {10.1111/mec.12383},
ISSN = {0962-1083},
EISSN = {1365-294X},
Keywords = {alpine-Mediterranean; Bayesian skyline plots; conservation; climate
   change; effective population size; Linaria; species distribution
   modelling},
Keywords-Plus = {NORTHERN-HEMISPHERE TEMPERATURES; CLIMATE-CHANGE; BAYESIAN-INFERENCE;
   POPULATION-SIZE; HAPLOTYPE RECONSTRUCTION; EVOLUTIONARY ADAPTATION;
