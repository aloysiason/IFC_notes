@article{ ISI:000263883500010,
Author = {Marcott, Shaun A. and Fountain, Andrew G. and O'Connor, Jim E. and
   Sniffen, Peter J. and Dethier, David P.},
Title = {A latest Pleistocene and Holocene glacial history and paleoclimate
   reconstruction at Three Sisters and Broken Top Volcanoes, Oregon, USA},
Journal = {QUATERNARY RESEARCH},
Year = {2009},
Volume = {71},
Number = {2},
Pages = {181-189},
Month = {MAR},
Abstract = {At least three sets of moraines mark distinct glacial stands since the
   last glacial maximum (LGM) in the Three Sisters region of the Oregon
   Cascade Range. The oldest stand predates 8.1 ka (defined here as
   post-LGM), followed by a second between similar to 2 and 8 ka
   (Neoglacial) and a third from the Little Ice Age (LIA) advance of the
   last 300 years. The post-LGM equilibrium line altitudes were 260 100 m
   lower than that of modern glaciers, requiring 23 +/- 9\% increased
   winter snowfall and 1.4 +/- 0.5 degrees C cooler summer temperatures
   than at present. The LIA advance had equilibrium line altitudes 110 40
   in lower than at present, implying 10 +/- 4\% greater winter snowfall
   and 0.6 +/- 0.2 degrees C cooler surnmer temperatures. (c) 2008
   University of Washington. All rights reserved.},
