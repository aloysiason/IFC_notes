@article{ ISI:000235948900011,
Author = {Brunner, K},
Title = {Information on climate changes gathered from historical documents},
Journal = {MITTEILUNGEN DER OSTERREICHISCHEN GEOGRAPHISCHEN GESELLSCHAFT},
Year = {2005},
Volume = {147},
Pages = {237-264},
Abstract = {Information on climate changes gathered from historical documents Maps
   of Latin PTOLEMY-Editions of the 15(th) century depict sea ice in
   Northern Europe. Early in the the 17(th) century the search for a
   Northwest Oassage failed. The medieval warm period had ended, and only
   around 1850 - at the end of the ``little ice age{''} - it became
   passable. The climate change during the early modern times was also
   documented in ,,seasons' paintings{''} since the Middle Ages and by
   manuscript maps from 1500 onwards. The latter nt often show the
   abandoning of viticulture and the occasionally disastrous advance of
   Alpine glaciers. The glaciation maximums in the 17(th) century and at
   the end of the 18(th) century are recorded in maps and vedutes. As from
   1565 Pieter BRUEGHEL painted winter scenes, and during all of the 17(th)
   century Dutch artists creatde sceneries with snow and ice. In the middle
   of the 19(th) century the first glacier maps were published, thus
   incidentally recording the most recent glaciation maximum in the Alps.
   As from 1880 exact maps document a retreat of the Alpine glaciers.},
