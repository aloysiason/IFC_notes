   Brewer, S.; Alleaume, S.; Guiot, J., Univ Paul Cezanne, CEREGE, CNRS, UMR 6635, F-13545 Aix En Provence, France.
   Nicault, A., Univ Laval, Ctr Etud Nord, Ste Foy, PQ G1K 7P4, Canada.},
ISSN = {1814-9324},
Keywords-Plus = {MEDIEVAL WARM PERIOD; CLIMATE-CHANGE; MODEL SIMULATIONS; COUPLED MODEL;
   MIDHOLOCENE CLIMATE; NORTH-ATLANTIC; TEMPERATURE; EUROPE; SOLAR;
   RECONSTRUCTION},
Research-Areas = {Geology; Meteorology \& Atmospheric Sciences},
Web-of-Science-Categories  = {Geosciences, Multidisciplinary; Meteorology \& Atmospheric Sciences},
