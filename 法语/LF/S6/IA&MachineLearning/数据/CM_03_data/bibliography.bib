Year = {2002},
Volume = {29},
Number = {10},
Month = {MAY 15},
Abstract = {{[}1] We test the performance of proxy-based climate field
   reconstruction methods using sets of synthetic proxy climate indicators.
   `Pseudoproxies' are constructed through the degradation of instrumental
   surface temperature data by additive noise with variable statistical
   properties. Experiments are performed using pseudoproxy networks of
   varying spatial and seasonal representation and with varying noise
   attributes. Implications for sampling strategies for improved
   paleoclimate reconstructions are discussed.},
