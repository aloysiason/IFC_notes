@article{ ISI:000232958600002,
Author = {Esper, J and Wilson, RJS and Frank, DC and Moberg, A and Wanner, H and
   Luterbacher, J},
Title = {Climate: past ranges and future changes},
Journal = {QUATERNARY SCIENCE REVIEWS},
Year = {2005},
Volume = {24},
Number = {20-21},
Pages = {2164-2166},
Month = {NOV},
Abstract = {Comparison of large-scale temperature reconstructions over the past
   millennium reveals agreement on major climatic episodes, but substantial
   divergence in reconstructed (absolute) temperature amplitude. We here
   detail several research priorities to overcome this `amplitude
   desideratum', and discuss the relevance of this effort for the
