   Univ Arizona, Lunar \& Planetary Lab, Tucson, AZ 85721 USA.
   Univ Reading, Dept Meteorol, Reading RG6 6BB, Berks, England.
   Univ Thessaloniki, Dept Meteorol \& Climatol, GR-54006 Thessaloniki, Greece.},
DOI = {10.1023/A:1014217317898},
ISSN = {0169-3298},
Keywords = {atmospheric circulation; climate; flow; North Atlantic Oscillation},
Keywords-Plus = {SEA-SURFACE TEMPERATURE; GENERAL-CIRCULATION MODEL; LOW-FREQUENCY
