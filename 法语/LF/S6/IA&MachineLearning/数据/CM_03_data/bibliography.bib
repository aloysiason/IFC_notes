Volume = {43},
Number = {2A, 1},
Pages = {439-447},
Note = {17th International Radiocarbon Conference, JERUSALEM, ISRAEL, JUN 18-23,
   2000},
Abstract = {We performed a statistical analysis of the data on summer temperature
   anomalies in northern Fennoscandia (81995 AD) and found that a 70-130-yr
   cycle is present in this series during most of the time period. A
   comparison of the reconstructed northern Fennoscandia temperature with
   different indicators of solar activity (Wolf numbers, the length of
   solar Schwabe cycle, extended bi-decadal radiocarbon series, and data on
   sunspots observed by naked eye) shows that the more probable cause of
   the periodicity is the modulation of regional northern Fermoscandia
   climate by the long-term solar cycle of Gleissberg. The effect of this
   century-scale solar modulation of the global Northern Hemisphere
   temperature is weaker.},
