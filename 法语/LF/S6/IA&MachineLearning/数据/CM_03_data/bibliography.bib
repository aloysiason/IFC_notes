@article{ ISI:000293288400019,
Author = {Koch, Johannes and Clague, John J.},
Title = {Extensive glaciers in northwest North America during Medieval time},
Journal = {CLIMATIC CHANGE},
Year = {2011},
Volume = {107},
Number = {3-4},
Pages = {593-613},
Month = {AUG},
Abstract = {The Medieval Warm Period is an interval of purportedly warm climate
   during the early part of the past millennium. The duration, areal
   extent, and even existence of the Medieval Warm Period have been
   debated; in some areas the climate of this interval appears to have been
   affected more by changes in precipitation than in temperature. Here, we
   provide new evidence showing that several glaciers in western North
   America advanced during Medieval time and that some glaciers achieved
   extents similar to those at the peak of the Little Ice Age, many hundred
   years later. The advances cannot be reconciled with a climate similar to
   that of the twentieth century, which has been argued to be an analog,
   and likely were the result of increased winter precipitation due to
   prolonged La Nia-like conditions that, in turn, may be linked to
   elevated solar activity. Changes in solar output may initiate a response
   in the tropical Pacific that directly impacts the El Nio/Southern
   Oscillation and associated North Pacific teleconnections.},
Publisher = {SPRINGER},
