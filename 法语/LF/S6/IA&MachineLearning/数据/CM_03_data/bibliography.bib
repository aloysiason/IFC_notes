@article{ ISI:000184867500003,
Author = {Mann, ME and Jones, PD},
Title = {Global surface temperatures over the past two millennia},
Journal = {GEOPHYSICAL RESEARCH LETTERS},
Year = {2003},
Volume = {30},
Number = {15},
Month = {AUG 14},
Abstract = {We present reconstructions of Northern and Southern Hemisphere mean
   surface temperature over the past two millennia based on high-resolution
   `proxy' temperature data which retain millennial-scale variability.
   These reconstructions indicate that late 20th century warmth is
   unprecedented for at least roughly the past two millennia for the
   Northern Hemisphere. Conclusions for the Southern Hemisphere and global
   mean temperature are limited by the sparseness of available proxy data
   in the Southern Hemisphere at present.},
