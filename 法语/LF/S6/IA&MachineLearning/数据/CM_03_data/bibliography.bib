   Mary and Grudd, Hakan and Jalkanen, Risto and Loader, Neil J. and
   Robertson, Iain},
Title = {A critical evaluation of multi-proxy dendroclimatology in northern
   Finland},
Journal = {JOURNAL OF QUATERNARY SCIENCE},
