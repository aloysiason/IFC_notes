Number = {6},
Pages = {33-41},
Month = {NOV},
Abstract = {Images of climate change and global warmingincluding tens of thousands
   of photographs, charts, graphs, cartoons, illustrations, and moving
   imageshave been spread across magazines, television, and films, and are
   scrolling down the growing array of websites devoted to some aspect of
   environmental news and climate change. The content of climate imagery
   falls into several broad categories, and not all of them have been
   effective in educating people about the dangers and causes of climate
   change or encouraging civic action and involvement. A new framing of
   local climate impacts and positive actions may encourage more people to
   take action.},
