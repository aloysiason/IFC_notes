@article{ ISI:000287433100006,
Author = {Norbury, John W.},
Title = {Perspective on space radiation for space flights in 2020-2040},
Journal = {ADVANCES IN SPACE RESEARCH},
Year = {2011},
Volume = {47},
Number = {4},
Pages = {611-621},
Month = {FEB 15},
Abstract = {The Sun undergoes several well known periodicities in activity, such as
   the Schwabe 11 year cycle, the Gleissberg 80-90 year cycle, the Suess
   200-210 year cycle and the Halstatt 2200-2300 year cycle. In addition,
   there is evidence that the 20th century levels of solar activity are
   unusually high. The years 2020-2040 are expected to coincide with
   increased activity in human space flight beyond low Earth orbit. The
   solar cycles and the present level of solar activity are reviewed and
   their activities during the years 2020-2040 are discussed with a
   perspective on space radiation and the future program of space flight.
   It is prudent to prepare for continuing levels of high solar activity as
   well as for the low levels of the current deep minimum, which has
   corresponded to high galactic cosmic ray flux. Published by Elsevier
   Ltd. on behalf of COSPAR.},
