@inproceedings{ ISI:000245916100008,
Author = {Haigh, Joanna D.},
Editor = {Lilensten, J},
Title = {Solar variability and climate},
Booktitle = {Space Weather: Research Towards Applications In Europe},
Series = {ASTROPHYSICS AND SPACE SCIENCE LIBRARY},
Year = {2007},
Volume = {344},
