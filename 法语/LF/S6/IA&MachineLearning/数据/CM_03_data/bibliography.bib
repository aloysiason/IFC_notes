@article{ ISI:000233486100008,
Author = {Goto, S and Hamamoto, H and Yamano, M},
Title = {Climatic and environmental changes at southeastern coast of Lake Biwa
   over past 3000 years, inferred from borehole temperature data},
Journal = {PHYSICS OF THE EARTH AND PLANETARY INTERIORS},
Year = {2005},
Volume = {152},
Number = {4},
Pages = {314-325},
Month = {OCT 30},
Note = {Symposium on Thermally Controlled Processes and Preserved Thermal
   Signatures Within the Earth, Sapporo, JAPAN, JUN 30-JUL 11, 2003},
Organization = {IUGG},
Abstract = {In order to infer past climatic change in central Japan, we measured
   temperatures in a borehole at the Karasuma site, on the southeastern
   coast of Lake Biwa, and reconstructed sediment surface temperature
   history during the last 3000 years. The reconstructed temperature
   history shows apparent Medieval Warm Period, Little Ice Age, and
   contemporary temperature warming, However, the large amplitude of the
   temperature changes up to 4-5 K cannot be explained by past climatic
   change only, suggesting that there was some other cause of the larger
   amplitude temperature changes. The onsets of temperature decrease in the
   late 12th century A.D. and temperature increase in the mid 17th century
   A.D. appear to coincide with occurrences of two destructive earthquakes
   (1185 and 1662 A.D.) that caused water level changes of Lake Biwa. It
   suggests that the reconstructed sediment surface temperature history
   reflects the environmental change due to tectonically induced water
   level changes of the lake. If the annual mean of the ground surface
   temperature was higher than that of the bottom water temperature in a
   shallow part of the lake, which is consistent with the present-day data,
   the large amplitude of the sediment surface temperature change may be
   attributed to a combined effect of past climatic and environmental
   changes. Thus, we suggest that the borehole temperature at the Karasuma
   site preserves information not only on past climate changes but also on
   environmental changes due to tectonically induced water level changes.
   (c) 2005 Elsevier B.V. All rights reserved.},
