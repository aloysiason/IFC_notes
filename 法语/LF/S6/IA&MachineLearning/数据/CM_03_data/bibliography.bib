Language = {English},
Affiliation = {Harris, RN (Reprint Author), Univ Utah, Dept Geol \& Geophys, Salt Lake City, UT 84112 USA.
   Univ Utah, Dept Geol \& Geophys, Salt Lake City, UT 84112 USA.},
DOI = {10.1029/2000GL012348},
ISSN = {0094-8276},
Keywords-Plus = {NORTHERN-HEMISPHERE; MILLENNIUM; COVER},
Research-Areas = {Geology},
Web-of-Science-Categories  = {Geosciences, Multidisciplinary},
