@article{ ISI:000236343600034,
Author = {Levy, O and Rosenfeld, M and Yam, R and Shemesh, A},
Title = {Heterogeneity of coral skeletons isotopic compositions during the 1998
   bleaching event},
Journal = {LIMNOLOGY AND OCEANOGRAPHY},
Year = {2006},
Volume = {51},
Number = {2},
Pages = {1142-1148},
Month = {MAR},
Abstract = {The vulnerability of coral reefs to climate change, Such as regional
   warming, became fully evident during the strong 1997-1998 El Nino event,
   This El Nino episode was associated with elevated sea-surface
   temperatures and caused mass mortality throughout many of the world's
   coral reefs. We analyzed the isotopic manifestation of this event in six
   Porites sp. coral skeletons from different localities in a small atoll
   (Alphonse) at the Seychelles Island. The aim was to validate the use of
   coral stable isotope compositions as recorders of such events in the
   past. The coupling between local-scale environment and global warming
   was weaker then expected, with regional warming being evident only when
   data from five colonies were averaged. Local conditions had a large
   effect on the isotopic compositions of coral skeletons. We conclude that
   future paleoclimate reconstructions, especially those attempts to
   identify past El Nino events, must be based on more than a single coral
   record. Moreover, the strong effect of local habitat on the isotopic
   composition of Porites sp. has to be considered when interpreting delta
   C-13 and delta O-18 records.},
