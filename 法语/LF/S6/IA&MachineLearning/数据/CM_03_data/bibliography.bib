@article{ ISI:000281689200019,
Author = {Pessenda, Luiz C. R. and Saia, Soraya E. M. G. and Gouveia, Susy E. M.
   and Ledru, Marie-Pierre and Sifeddine, Abdelfettah and Amaral, Paula G.
   C. and Bendassolli, Jose A.},
Title = {Last millennium environmental changes and climate inferences in the
   Southeastern Atlantic forest, Brazil},
Journal = {ANAIS DA ACADEMIA BRASILEIRA DE CIENCIAS},
Year = {2010},
Volume = {82},
Number = {3},
Pages = {717-729},
Month = {SEP},
Abstract = {This study presents paleoenvironmental data based on pollen, elemental
   and isotopic compositions of organic matter (TOC, N, delta(13)C and
   delta(15)N) and (14)C dating of 170 cm lake sediment record. Samplings
   have been made in Lagoa Grande at Parque Estadual Turistico do Alto
   Ribeira - PETAR, Southern Sao Paulo State, Southeastern Brazil. The
   variations in relative frequencies (in percentage) of arboreal pollen
   along the core range between 40 and 80\%. The d13C values ranged from -
   23 parts per thousand h to - 30 parts per thousand h and C/N of similar
   to 10 to 15, indicating the contribution of terrestrial C(3) plants and
   algae in the sediment organic matter. The delta(15)N results presented
   values from 3 to 4.5 h, also suggesting a mixture of algae and
