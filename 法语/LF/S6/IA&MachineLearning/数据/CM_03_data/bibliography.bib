@article{ ISI:000345964600007,
Author = {Nagovitsyn, Yu. A.},
Title = {Specific features in the effect of solar activity on the Earth's climate
   changes},
Journal = {GEOMAGNETISM AND AERONOMY},
Year = {2014},
Volume = {54},
Number = {8},
Pages = {1010-1013},
Month = {DEC},
Abstract = {The effect of solar activity on climate has been considered. It has been
   shown that the total contribution of solar activity to changes in the
   Earth's global temperature is insignificant but not negligible: about a
   fifth of the temperature dispersion is related to solar activity. This
   contribution strongly depends on the time scale: it is under 5\% for
   cyclic variations with periods shorter than 40-50 years (about 1\% for
   the 11-year variations) and starts sharply increasing for the times on
   the order of the 80- to 90-year Gleissberg cycle, reaching its maximum
   (about 40-50\%) for the 200-year Suess cycle.},
