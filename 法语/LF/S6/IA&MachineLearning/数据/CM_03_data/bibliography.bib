Title = {A multi-century ice-core perspective on 20th-century climate changewith
   new contributions from high-Arctic and Greenland (PARCA) cores},
Booktitle = {ANNALS OF GLACIOLOGY, VOL 43, 2006},
Series = {Annals of Glaciology-Series},
